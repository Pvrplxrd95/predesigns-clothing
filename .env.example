# Predesigns Clothing - Environment Configuration
# Copy this file to .env and add your actual API keys
# DO NOT commit the .env file to git - it contains sensitive information
#
# NOTE: This is a static site with no build step. For local development,
# edit js/env.js directly (replace placeholder values with real keys).
# js/env.js is gitignored and should never be committed with real secrets.
# These variables are read by js/config.js via window.__ENV__.

# ============================================
# SNIPCART E-COMMERCE INTEGRATION
# ============================================
# Get your API key from: https://dashboard.snipcart.com
# Use 'pk_test_...' for testing, 'pk_live_...' for production
SNIPCART_API_KEY=pk_test_YOUR_TEST_KEY_HERE

# Snipcart Environment: 'test' or 'live'
# Use 'test' for development, 'live' for production
SNIPCART_ENVIRONMENT=test

# ============================================
# YOCO PAYMENT GATEWAY (Optional)
# ============================================
# Get your API key from: https://www.yoco.com
# For integration with payment processing
YOCO_PUBLIC_KEY=pk_test_YOUR_YOCO_KEY_HERE
YOCO_ENVIRONMENT=test

# ============================================
# EMAIL NOTIFICATIONS
# ============================================
# Mailerlite for email marketing and notifications
MAILERLITE_API_KEY=YOUR_MAILERLITE_API_KEY_HERE
MAILERLITE_GROUP_ID=YOUR_MAILERLITE_GROUP_ID_HERE

# ============================================
# GITHUB GISCUS (Comments & Discussions)
# ============================================
# Get these from: https://giscus.app
GISCUS_REPO=YOUR_USERNAME/YOUR_REPO_NAME
GISCUS_REPO_ID=YOUR_REPO_ID_HERE
GISCUS_CATEGORY_ID=DIC_kwDOXXXXXX4XXXXXX

# ============================================
# FIREBASE BACKEND (Auth & Firestore)
# ============================================
# Get these from: https://console.firebase.google.com
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
GOOGLE_CLIENT_ID=your_google_client_id_here

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
# 'development', 'testing', or 'production'
NODE_ENV=development

# Base URL for the application
APP_URL=http://localhost:3000

# Enable debug logging
DEBUG_MODE=false
